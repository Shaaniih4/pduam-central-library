# PDUAM Central Library Management System Environment Variables
# Copy this file to .env in your root directory

# Flask Application Settings
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=pduam-central-library-super-secret-production-key-2026

# Database Path (default SQLite)
DATABASE_PATH=instance/library.db

# Institutional Metadata
LIBRARY_NAME="PDUAM Central Library"
INSTITUTION_NAME="Pandit Deendayal Upadhyaya Adarsha Mahavidyalaya, Amjonga"

# Optional Email / SMTP Configuration
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=library@pduamamjonga.ac.in
MAIL_PASSWORD=your-app-password-here
